{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TubeGrab",
  "version": "0.1.0",
  "identifier": "com.amose.tubegrab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:15420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TubeGrab",
        "width": 920,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
